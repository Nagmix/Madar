# ══════════════════════════════════════════════════════════════════
# Trippo Backend - Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env files to version control.
# ══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
# PostgreSQL 16 + PostGIS connection string
DATABASE_URL=postgresql://trippo:CHANGE_ME_STRONG_PASSWORD@localhost:5432/trippo_db?schema=public

# PostgreSQL container credentials (used by docker-compose)
POSTGRES_USER=trippo
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=trippo_db

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT Authentication ────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_A_64_BYTE_HEX_STRING
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_64_BYTE_HEX_STRING
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ── Google Maps ───────────────────────────────────────────────────
# Required for distance calculation, geocoding, and route optimization
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ── Firebase Cloud Messaging (Push Notifications) ────────────────
# Used for push notifications only — NOT for auth or database
FCM_PROJECT_ID=your_fcm_project_id
FCM_PRIVATE_KEY=your_fcm_private_key
FCM_CLIENT_EMAIL=your_fcm_client_email
FCM_SERVER_KEY=your_fcm_server_key

# ── Twilio (SMS Verification) ────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ── SMTP (Email) ─────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# ── MinIO / S3 Storage ───────────────────────────────────────────
# Used for document uploads (driver licenses, vehicle photos, etc.)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=trippo_minio
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=trippo

# ── Stripe (Payments) ────────────────────────────────────────────
# Required for processing rider payments and driver payouts
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_STRIPE_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME_STRIPE_PUBLISHABLE_KEY

# ── Sentry (Error Monitoring) ────────────────────────────────────
# Optional but recommended for production error tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ── App Configuration ────────────────────────────────────────────
APP_PORT=3000
NODE_ENV=production
FRONTEND_URL=https://trippo.app

# ── Platform Commission Rate ─────────────────────────────────────
# Percentage the platform takes from each trip (0.20 = 20%)
COMMISSION_RATE=0.20
