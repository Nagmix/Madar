// ============================================
// TRIPPO - Ride Hailing Platform Database Schema
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTH & USERS
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  // oauth, credentials
  provider          String  // google, facebook, credentials
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum UserRole {
  ADMIN
  DISPATCHER
  SUPPORT
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  avatar        String?
  passwordHash  String?
  role          UserRole  @default(ADMIN)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

// ============================================
// RIDERS (Customers)
// ============================================

enum RiderStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

model Rider {
  id                String       @id @default(cuid())
  email             String       @unique
  name              String
  phone             String       @unique
  avatar            String?
  firebaseUid       String?
  fcmToken          String?
  status            RiderStatus  @default(PENDING_VERIFICATION)
  rating            Float        @default(0)
  totalRides        Int          @default(0)
  cancelledRides    Int          @default(0)
  cancellationRate  Float        @default(0)
  isVerified        Boolean      @default(false)
  deviceType        String?      // ios, android
  appVersion        String?
  preferredLanguage String       @default("ar")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  trips            Trip[]
  wallet           Wallet?
  notifications    Notification[]
  fraudAlerts      FraudAlert[]
  riderLocations   RiderLocation[]
  favoritePlaces   FavoritePlace[]

  @@index([phone])
  @@index([status])
  @@index([email])
}

model RiderLocation {
  id        String   @id @default(cuid())
  riderId   String
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  accuracy  Float?
  createdAt DateTime @default(now())

  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([latitude, longitude])
}

model FavoritePlace {
  id        String   @id @default(cuid())
  riderId   String
  name      String   // Home, Work, etc.
  address   String
  latitude  Float
  longitude Float
  placeId   String?  // Google Place ID
  icon      String?
  createdAt DateTime @default(now())

  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
}

// ============================================
// DRIVERS
// ============================================

enum DriverStatus {
  OFFLINE
  ONLINE
  BUSY
  ON_TRIP
  SUSPENDED
  BANNED
  PENDING_APPROVAL
  PENDING_DOCUMENTS
}

enum VehicleType {
  SEDAN
  SUV
  VAN
  MOTORCYCLE
  LUXURY
  ELECTRIC
  ACCESSIBLE
}

model Driver {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String
  phone               String       @unique
  avatar              String?
  firebaseUid         String?
  fcmToken            String?
  status              DriverStatus @default(PENDING_APPROVAL)
  rating              Float        @default(0)
  totalTrips          Int          @default(0)
  acceptedTrips       Int          @default(0)
  rejectedTrips       Int          @default(0)
  acceptanceRate      Float        @default(0)
  cancellationRate    Float        @default(0)
  isVerified          Boolean      @default(false)
  isOnline            Boolean      @default(false)
  lastOnlineAt        DateTime?
  totalOnlineHours    Float        @default(0)
  deviceType          String?
  appVersion          String?
  preferredLanguage   String       @default("ar")
  emergencyContact    String?
  emergencyName       String?
  bankAccountNumber   String?
  bankName            String?
  bankIban            String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  vehicle             Vehicle?
  driverLocations     DriverLocation[]
  trips               Trip[]
  wallet              Wallet?
  documents           DriverDocument[]
  notifications       Notification[]
  fraudAlerts         FraudAlert[]
  driverIncentives    DriverIncentive[]
  driverPenalties     DriverPenalty[]
  settlements         Settlement[]

  @@index([phone])
  @@index([status])
  @@index([isOnline])
  @@index([email])
}

model Vehicle {
  id            String      @id @default(cuid())
  driverId      String      @unique
  type          VehicleType @default(SEDAN)
  make          String
  model         String
  year          Int
  color         String
  plateNumber   String      @unique
  capacity      Int         @default(4)
  hasAC         Boolean     @default(true)
  isAccessible  Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  driver        Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([plateNumber])
}

model DriverDocument {
  id          String   @id @default(cuid())
  driverId    String
  type        String   // license, insurance, registration, id_card, vehicle_inspection
  documentUrl String
  status      String   @default("pending") // pending, approved, rejected, expired
  expiresAt   DateTime?
  reviewedBy  String?
  reviewedAt  DateTime?
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([type])
  @@index([status])
}

model DriverLocation {
  id        String   @id @default(cuid())
  driverId  String
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  accuracy  Float?
  isMocked  Boolean  @default(false)
  createdAt DateTime @default(now())

  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([latitude, longitude])
}

// ============================================
// TRIPS (Ride State Machine)
// ============================================

enum TripStatus {
  SEARCHING_DRIVER
  DRIVER_ASSIGNED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  TRIP_STARTED
  TRIP_PAUSED
  TRIP_RESUMED
  TRIP_COMPLETED
  PAYMENT_PENDING
  PAYMENT_COMPLETED
  TRIP_CANCELLED
  TRIP_EXPIRED
}

enum TripCancelReason {
  RIDER_CANCELLED
  DRIVER_CANCELLED
  NO_DRIVER_FOUND
  DRIVER_NO_SHOW
  RIDER_NO_SHOW
  SYSTEM_CANCELLED
  PAYMENT_FAILED
  SAFETY_CONCERN
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  PROMO_CODE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Trip {
  id                    String           @id @default(cuid())
  tripNumber            String           @unique
  riderId               String
  driverId              String?

  // Origin
  originAddress         String
  originLat             Float
  originLng             Float
  originPlaceId         String?

  // Destination
  destinationAddress    String
  destinationLat        Float
  destinationLng        Float
  destinationPlaceId    String?

  // Route info
  distanceMeters        Int?
  durationSeconds       Int?
  polyline              String?          // Encoded polyline
  waypoints             String?          // JSON array of waypoints

  // Status
  status                TripStatus       @default(SEARCHING_DRIVER)
  cancelReason          TripCancelReason?
  cancelReasonText      String?

  // Pricing
  baseFare              Float            @default(0)
  distanceFare          Float            @default(0)
  timeFare              Float            @default(0)
  surgeMultiplier       Float            @default(1.0)
  waitingFee            Float            @default(0)
  tollFee               Float            @default(0)
  cancellationFee       Float            @default(0)
  promoDiscount         Float            @default(0)
  totalFare             Float            @default(0)
  currency              String           @default("SAR")

  // Payment
  paymentMethod         PaymentMethod    @default(CASH)
  paymentStatus         PaymentStatus    @default(PENDING)

  // Vehicle type requested
  vehicleTypeRequested  VehicleType      @default(SEDAN)

  // Ratings
  riderRating           Float?
  driverRating          Float?
  riderReview           String?
  driverReview          String?

  // Timestamps
  requestedAt           DateTime         @default(now())
  driverAssignedAt      DateTime?
  driverArrivingAt      DateTime?
  driverArrivedAt       DateTime?
  tripStartedAt         DateTime?
  tripCompletedAt       DateTime?
  tripCancelledAt       DateTime?
  paymentCompletedAt    DateTime?

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  // Relations
  rider                 Rider            @relation(fields: [riderId], references: [id])
  driver                Driver?          @relation(fields: [driverId], references: [id])
  tripEvents            TripEvent[]
  tripLocations         TripLocation[]
  payment               Payment?
  promoUsage            PromoUsage?

  @@index([riderId])
  @@index([driverId])
  @@index([status])
  @@index([requestedAt])
  @@index([tripNumber])
}

model TripEvent {
  id          String     @id @default(cuid())
  tripId      String
  status      TripStatus
  actor       String     // rider, driver, system, admin
  actorId     String?
  metadata    String?    // JSON for extra data
  createdAt   DateTime   @default(now())

  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([createdAt])
}

model TripLocation {
  id        String   @id @default(cuid())
  tripId    String
  driverId  String
  latitude  Float
  longitude Float
  heading   Float?
  speed     Float?
  recordedAt DateTime @default(now())

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([recordedAt])
}

// ============================================
// PAYMENTS & WALLETS
// ============================================

model Wallet {
  id        String   @id @default(cuid())
  ownerId   String   @unique // rider or driver id
  ownerType String   // rider, driver
  balance   Float    @default(0)
  currency  String   @default("SAR")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rider         Rider?        @relation(fields: [ownerId], references: [id])
  driver        Driver?       @relation(fields: [ownerId], references: [id])
  transactions  Transaction[]
  settlements   Settlement[]

  @@index([ownerId])
  @@index([ownerType])
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  COMMISSION
  INCENTIVE
  PENALTY
  WITHDRAWAL
  TOP_UP
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model Transaction {
  id              String            @id @default(cuid())
  walletId        String
  type            TransactionType
  amount          Float
  currency        String            @default("SAR")
  status          TransactionStatus @default(PENDING)
  description     String?
  referenceType   String?           // trip, settlement, incentive, penalty
  referenceId     String?           // trip id, settlement id, etc.
  metadata        String?           // JSON
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  wallet          Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id              String         @id @default(cuid())
  tripId          String         @unique
  amount          Float
  currency        String         @default("SAR")
  method          PaymentMethod
  status          PaymentStatus  @default(PENDING)
  gatewayRef      String?        // Payment gateway reference
  gatewayResponse String?        // JSON response from gateway
  processedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  trip            Trip           @relation(fields: [tripId], references: [id])

  @@index([tripId])
  @@index([status])
}

model Settlement {
  id              String    @id @default(cuid())
  driverId        String
  walletId        String
  periodStart     DateTime
  periodEnd       DateTime
  totalTrips      Int       @default(0)
  totalEarnings   Float     @default(0)
  commission      Float     @default(0)
  incentives      Float     @default(0)
  penalties       Float     @default(0)
  netAmount       Float     @default(0)
  status          String    @default("pending") // pending, processing, completed, failed
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  driver          Driver    @relation(fields: [driverId], references: [id])
  wallet          Wallet    @relation(fields: [walletId], references: [id])

  @@index([driverId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// ============================================
// PRICING ENGINE
// ============================================

model PricingTier {
  id              String      @id @default(cuid())
  name            String
  vehicleType     VehicleType @default(SEDAN)
  baseFare        Float       @default(0)
  perKmRate       Float       @default(0)
  perMinuteRate   Float       @default(0)
  minimumFare     Float       @default(0)
  cancellationFee Float       @default(0)
  waitingFeePerMinute Float   @default(0)
  freeWaitingMinutes   Int    @default(3)
  currency        String      @default("SAR")
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  zonePricings    ZonePricing[]

  @@index([vehicleType])
  @@index([isActive])
}

model SurgePricing {
  id              String   @id @default(cuid())
  name            String
  multiplier      Float    @default(1.0)
  startTime       String   // HH:mm format
  endTime         String   // HH:mm format
  daysOfWeek      String   // JSON array [0-6], 0=Sunday
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}

model ZonePricing {
  id              String       @id @default(cuid())
  pricingTierId   String
  name            String
  type            String       @default("polygon") // polygon, circle
  coordinates     String       // JSON: [[lat,lng],...] or {center:[lat,lng], radius:km}
  multiplier      Float        @default(1.0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  pricingTier     PricingTier  @relation(fields: [pricingTierId], references: [id], onDelete: Cascade)

  @@index([pricingTierId])
  @@index([isActive])
}

// ============================================
// PROMOS & INCENTIVES
// ============================================

model PromoCode {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  discountType    String   // percentage, fixed
  discountValue   Float
  maxDiscount     Float?
  minTripFare     Float    @default(0)
  maxUses         Int?
  currentUses     Int      @default(0)
  maxUsesPerUser  Int      @default(1)
  validFrom       DateTime
  validUntil      DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  promoUsages     PromoUsage[]

  @@index([code])
  @@index([isActive])
  @@index([validFrom, validUntil])
}

model PromoUsage {
  id          String     @id @default(cuid())
  promoId     String
  tripId      String     @unique
  riderId     String
  discountApplied Float
  createdAt   DateTime   @default(now())

  promoCode   PromoCode  @relation(fields: [promoId], references: [id])
  trip        Trip       @relation(fields: [tripId], references: [id])

  @@index([promoId])
  @@index([riderId])
}

model DriverIncentive {
  id          String   @id @default(cuid())
  driverId    String
  type        String   // bonus, streak, guarantee, quest
  title       String
  description String?
  amount      Float
  condition   String?  // JSON: trip count, hours online, etc.
  status      String   @default("pending") // pending, earned, paid, expired
  earnedAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([status])
}

model DriverPenalty {
  id          String   @id @default(cuid())
  driverId    String
  type        String   // cancellation_no_show, low_rating, fraud, policy_violation
  reason      String
  amount      Float    @default(0)
  points      Int      @default(0) // penalty points
  status      String   @default("active") // active, appealed, waived, served
  createdBy   String?
  createdAt   DateTime @default(now())

  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([type])
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationType {
  TRIP_UPDATE
  PAYMENT
  PROMO
  SYSTEM
  ALERT
  DRIVER_DOCUMENT
  VERIFICATION
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
  EMAIL
  IN_APP
}

model Notification {
  id          String            @id @default(cuid())
  userId      String?           // admin user
  riderId     String?
  driverId    String?
  type        NotificationType
  channel     NotificationChannel @default(IN_APP)
  title       String
  body        String
  data        String?           // JSON payload
  isRead      Boolean           @default(false)
  sentAt      DateTime?
  readAt      DateTime?
  createdAt   DateTime          @default(now())

  rider       Rider?            @relation(fields: [riderId], references: [id])
  driver      Driver?           @relation(fields: [driverId], references: [id])

  @@index([riderId])
  @@index([driverId])
  @@index([isRead])
  @@index([createdAt])
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  type        NotificationType
  channel     NotificationChannel
  titleTemplate String
  bodyTemplate  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([channel])
}

// ============================================
// FRAUD DETECTION
// ============================================

enum FraudAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudAlertStatus {
  OPEN
  INVESTIGATING
  CONFIRMED
  FALSE_POSITIVE
  RESOLVED
}

model FraudAlert {
  id          String              @id @default(cuid())
  type        String              // gps_spoofing, fake_account, ghost_trip, multi_device, unusual_pattern
  severity    FraudAlertSeverity  @default(MEDIUM)
  status      FraudAlertStatus    @default(OPEN)
  riderId     String?
  driverId    String?
  tripId      String?
  description String
  evidence    String?             // JSON: evidence data
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  rider       Rider?              @relation(fields: [riderId], references: [id])
  driver      Driver?             @relation(fields: [driverId], references: [id])

  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([riderId])
  @@index([driverId])
}

// ============================================
// SERVICE AREAS (Geo Fences)
// ============================================

enum ZoneType {
  SERVICE_AREA
  NO_SERVICE_AREA
  AIRPORT
  EVENT_ZONE
  SURGE_ZONE
  RESTRICTED
}

model ServiceZone {
  id          String    @id @default(cuid())
  name        String
  nameAr      String?
  type        ZoneType  @default(SERVICE_AREA)
  coordinates String    // JSON: [[lat,lng],...]
  centerLat   Float?
  centerLng   Float?
  radius      Float?    // km, for circular zones
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([isActive])
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  changes     String?  // JSON: {before, after}
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// SYSTEM CONFIG
// ============================================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string") // string, number, boolean, json
  group     String?  // general, pricing, notifications, maps, etc.
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}
